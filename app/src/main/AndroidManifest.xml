<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      v2.0：朗读的锁屏 / 通知栏控制要挂一个前台服务。
      Android 14（API 34）起必须同时声明服务类型对应的权限，否则 startForeground 直接抛异常。
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!--
      文章朗读功能要绑定系统的文字转语音引擎。
      Android 11（API 30）起有「包可见性」限制：不声明 queries 的话，
      系统可能查不到 TTS 服务，TextToSpeech 会一直初始化失败（表现为点了朗读没反应）。
      官方文档明确要求声明这条 intent。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".YuewenApplication"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Yuewen">

        <!--
          v2.0：主 Activity **不再自己带 LAUNCHER intent-filter**，
          改由下面那组 activity-alias 承担「桌面图标 + 图标名称」的职责。

          为什么这么做：Android 不允许运行时改 `android:label`，
          想换桌面上的名字，唯一官方路径就是准备若干个 alias、
          用 PackageManager.setComponentEnabledSetting 启用其中一个。
          所以设置页提供的是「预设名字切换」而不是任意输入 ——
          应用内显示的名字（首页标题、关于页）才是真正可以随便写的。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:enableOnBackInvokedCallback="true"
            android:theme="@style/Theme.Yuewen" />

        <!-- 桌面图标名称预设。索引与 ui/util/IconNames.kt 里的列表严格对应，别单独改顺序。 -->
        <activity-alias
            android:name=".Alias0"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="true"
            android:icon="@drawable/ic_launcher"
            android:label="@string/icon_name_0"
            android:theme="@style/Theme.Yuewen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Alias1"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@drawable/ic_launcher"
            android:label="@string/icon_name_1"
            android:theme="@style/Theme.Yuewen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Alias2"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@drawable/ic_launcher"
            android:label="@string/icon_name_2"
            android:theme="@style/Theme.Yuewen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Alias3"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@drawable/ic_launcher"
            android:label="@string/icon_name_3"
            android:theme="@style/Theme.Yuewen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Alias4"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@drawable/ic_launcher"
            android:label="@string/icon_name_4"
            android:theme="@style/Theme.Yuewen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Alias5"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@drawable/ic_launcher"
            android:label="@string/icon_name_5"
            android:theme="@style/Theme.Yuewen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Alias6"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@drawable/ic_launcher"
            android:label="@string/icon_name_6"
            android:theme="@style/Theme.Yuewen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Alias7"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@drawable/ic_launcher"
            android:label="@string/icon_name_7"
            android:theme="@style/Theme.Yuewen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!--
          朗读前台服务。type 用 mediaPlayback：这是「持续播放音频」的标准类型，
          系统给它的存活优先级与音乐播放器同级。
        -->
        <service
            android:name=".service.TtsPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.example.yuewen.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
