<?xml version="1.0" encoding="utf-8"?>
<!--
  小组件底色（浅色）。
  ⚠️ 和 widget_bg_dark.xml 是**同一形状的两份颜色**，不是用 values-night 分的。
  原因：小组件跟着「App 里的主题设置」走，而那个设置可以手动锁成浅色/深色 ——
  values-night 只认系统的深色开关，用户把 App 锁成浅色、系统却是深色时就会配色错乱。
  所以两张 drawable 都由 Kotlin 侧按实际生效的深浅挑（见 WidgetUpdater）。
  半径 22dp 是为了和 Android 12+ 系统给小组件套的圆角大致对齐。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_bg_light" />
    <corners android:radius="22dp" />
</shape>
